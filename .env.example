# AgentTrace 环境变量样例。
#
# 使用方式：cp .env.example .env 后按需修改。
# 契约 B8：API Key 只能从环境变量读取，绝不入库、绝不进日志。
# 安全性：本文件是**样例**，不含任何真实密钥，可以提交到仓库。

# ------------------------------------------------------------------ 应用
APP_NAME=agenttrace
APP_VERSION=0.1.0
ENVIRONMENT=local
# DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO

# ------------------------------------------------------------------ 数据库
# Docker Compose 默认值（与 docker-compose.yml 中的凭据一致）
DATABASE_URL=postgresql+psycopg://agenttrace:agenttrace@localhost:5432/agenttrace
# 离线单元测试可改用 SQLite（不需要任何外部服务）：
# DATABASE_URL=sqlite+pysqlite:///./agenttrace.db
DB_ECHO=false
DB_CONNECT_TIMEOUT_SECONDS=5

# ------------------------------------------------------------------ Redis
REDIS_URL=redis://localhost:6379/0
REDIS_CONNECT_TIMEOUT_SECONDS=2
# Redis 不可用时是否允许降级继续（短期任务状态属可选能力）
REDIS_REQUIRED=false

# ------------------------------------------------------------------ LLM
# fake = 使用本地测试替身，不访问网络、不需要密钥（默认值，离线测试用这个）
# openai = OpenAI-compatible API，需要 LLM_API_KEY
# ollama = 本地 Ollama，通常不需要密钥
LLM_PROVIDER=fake
# 仅在 LLM_PROVIDER=openai 时需要填写。留空即可，不要提交真实密钥。
LLM_API_KEY=
# 自定义 OpenAI-compatible 端点；留空表示使用官方端点
LLM_BASE_URL=
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2

# ------------------------------------------------------------------ Agent
AGENT_VERSION=v1
PROMPT_VERSION=prompt-v1
AGENT_TIMEOUT_SECONDS=60
# 证据不足时允许的放宽检索重试次数
MAX_EVIDENCE_RETRIES=1
DEFAULT_TOP_K=3
# 证据覆盖率阈值：低于该值判为证据不足
EVIDENCE_COVERAGE_THRESHOLD=0.5

# ------------------------------------------------------------------ 工具治理
TOOL_MAX_RETRIES=2
TOOL_TIMEOUT_SECONDS=10
TOOL_SEARCH_MAX_TOP_K=10

# ------------------------------------------------------------------ 输入上限
MAX_QUESTION_CHARS=2000

# ------------------------------------------------------------------ Trace
# Trace 摘要截断长度，防止把完整 Prompt 或大响应写入数据库
SUMMARY_MAX_CHARS=500

# ------------------------------------------------------------------ 评测
EVAL_DATASET_DIR=data/eval
# 默认门禁阈值（JSON）。键名必须是 evaluation/metrics.py 导出的指标名。
GATE_DEFAULT_THRESHOLDS_JSON={"run_success_rate":{"min":0.90},"task_completion_rate":{"min":0.85},"tool_selection_accuracy":{"min":0.90},"tool_argument_accuracy":{"min":0.85},"evidence_coverage":{"min":0.70},"latency_ms_p95":{"max":2000},"estimated_cost_usd":{"max":0.05},"error_rate":{"max":0.05},"human_review_rate":{"max":0.00}}

# ------------------------------------------------------------------ 数据目录
SAMPLE_DOCS_DIR=data/sample_docs
PRICING_TABLE_PATH=app/evaluation/pricing.json

# ------------------------------------------------------------------ 测试开关
# 真实 LLM 集成测试默认关闭。默认测试路径不访问网络、不需要密钥。
ENABLE_REAL_LLM_TESTS=false
